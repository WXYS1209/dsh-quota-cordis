  "scripts": {"test": "node --test", "test:company-coverage": "node --test test/company-catalog-coverage.test.js", "sync:company-rules": "node scripts/sync-company-rules.js", "check:company-rules": "node scripts/sync-company-rules.js --check", "sync:company-brand-marks": "node scripts/sync-company-brand-marks.js", "check:company-brand-marks": "node scripts/sync-company-brand-marks.js --check", "check": "node --check company-brand-marks.js && node --check company-rules.js && node --check company-rules-storage.js && node --check index.js && node --check manager.js && node --check version.js && node --check route-hosts.js && node --check adapters.js && node --check openai-admin.js && node --check openai-costs.js && node --check openai-key-names.js && node --check codex-usage.js && node --check codex-oauth.js && node --check opencode-usage.js && node --check quota-settings.js && node --check client.js && node scripts/sync-company-rules.js --check && node scripts/sync-company-brand-marks.js --check"},
